# ============================================================================
# WTP Dynamic Pricing Engine - environment configuration
# Copy to .env and adjust. Every value below has a working default so the
# system runs fully offline with zero external accounts.
# ============================================================================

# ---- Postgres (decision + request logging) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wtp
POSTGRES_USER=wtp
POSTGRES_PASSWORD=wtp_dev_password
# Full async DSN used by the API (asyncpg). Overrides the parts above if set.
DATABASE_URL=postgresql://wtp:wtp_dev_password@postgres:5432/wtp

# ---- Redis (IP enrichment cache, 24h TTL) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
IP_CACHE_TTL_SECONDS=86400

# ---- Latency budget ----
# Hard ceiling for POST /personalize. Request returns 503 if exceeded.
LATENCY_BUDGET_MS=200

# ---- Model artifacts ----
MODEL_DIR=/app/model/artifacts
WTP_MODEL_FILE=wtp_estimator.joblib
CONVERSION_MODEL_FILE=conversion_classifier.joblib

# ---- External data sources (OPTIONAL - mock fallbacks used if absent) ----
# MaxMind GeoLite2: sign up free at https://www.maxmind.com/en/geolite2/signup
# then create a licence key. Without this the enrichment module uses its
# built-in synthetic ASN table.
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=
GEOIP_CITY_DB=/app/data/raw/geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB=/app/data/raw/geoip/GeoLite2-ASN.mmdb

# IPinfo free ASN dump: https://ipinfo.io/data (free tier, email signup).
# Without this the pipeline generates a synthetic asn.csv.
IPINFO_TOKEN=

# pytrends / Google Trends needs no key but is rate-limited; the pipeline
# falls back to a calibrated synthetic series when requests fail.
PYTRENDS_HL=en-IN
PYTRENDS_TZ=-330

# ---- Dashboard ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Data generation ----
SYNTHETIC_ROWS=50000
RANDOM_SEED=42
