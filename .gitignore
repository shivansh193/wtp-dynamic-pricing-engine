# ---- GeoIP databases (license-restricted, must be fetched) ----
*.mmdb
data/raw/geoip/

# ---- Local env / secrets ----
.env
.env.local
*.local

# ---- Cash Flow Oracle local store ----
cash-flow-oracle/*.sqlite3

# ---- smoke test output ----
scripts/smoke_output.json

# ---- OS noise ----
.DS_Store
Thumbs.db

# ---- Vercel CLI ----
.vercel/
.env.local
.env.*.local
!.env.example
